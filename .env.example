# Reference only. Real local values live in ~/.config/env_vars/dev-ai.env.
# FastAPI listens on 8002. Django stays on 8000. Do not put real secrets here.
APP_NAME=example-ai-service
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8002
DJANGO_API_BASE_URL=http://127.0.0.1:8000/
# Set when the base-URL host is not in Django ALLOWED_HOSTS (Docker Compose default: 127.0.0.1).
# DJANGO_API_HOST_HEADER=127.0.0.1
DJANGO_TIMEOUT_SECONDS=10
DJANGO_MAX_RESPONSE_BYTES=1048576
# Containers use /var/log/ai/app.log. Local WSL runs may use a project-relative path.
LOG_FILE_PATH=/var/log/ai/app.log
LLM_PROVIDER=example-provider
LLM_MODEL_ID=example-model-id
LLM_API_KEY=example-api-key
# LLM_BASE_URL=https://example.invalid
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=256
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=0
